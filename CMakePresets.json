{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-vs2022",
      "inherits": "windows-x64",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/windows-vs2022"
    }
  ],
  "buildPresets": [
    {"name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Debug"},
    {"name": "release", "configurePreset": "windows-x64", "configuration": "Release"},
    {"name": "vs2022-debug", "configurePreset": "windows-vs2022", "configuration": "Debug"},
    {"name": "vs2022-release", "configurePreset": "windows-vs2022", "configuration": "Release"}
  ],
  "testPresets": [
    {"name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "windows-vs2022", "configurePreset": "windows-vs2022", "configuration": "Debug", "output": {"outputOnFailure": true}}
  ]
}
