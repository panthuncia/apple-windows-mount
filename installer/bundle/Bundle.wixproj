<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>AppleWindowsMount-Setup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <AppMsi Condition="'$(AppMsi)' == ''">$(MSBuildProjectDirectory)\..\app\bin\Release\AppleWindowsMount.msi</AppMsi>
    <WinFspMsi Condition="'$(WinFspMsi)' == ''">$(MSBuildProjectDirectory)\..\..\.cache\winfsp-2.1.25156.msi</WinFspMsi>
    <DefineConstants>AppMsi=$(AppMsi);WinFspMsi=$(WinFspMsi)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
